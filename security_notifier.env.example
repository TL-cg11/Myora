# MariaDB notifier account (do not reuse the sink or API account)
SECURITY_DB_HOST=100.104.124.29
SECURITY_DB_PORT=3306
SECURITY_DB_NAME=security_monitoring
SECURITY_DB_USER=security_monitoring_notifier
SECURITY_DB_PASSWORD=change-me

# Queue policy
SECURITY_NOTIFICATION_CHANNELS=DISCORD
NOTIFICATION_IMMEDIATE_RISK_LEVEL=HIGH
NOTIFICATION_REPEATED_BEHAVIOR_MATCHES=3
NOTIFICATION_GROUP_WINDOW_SECONDS=60
NOTIFICATION_MAX_BATCH_SIZE=20
NOTIFICATION_MAX_RETRIES=5
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_RETRY_JITTER_SECONDS=5
NOTIFICATION_POLL_SECONDS=60
NOTIFICATION_UNRESOLVED_CRITICAL_HOURS=1
NOTIFICATION_UNRESOLVED_HIGH_HOURS=4
NOTIFICATION_UNRESOLVED_MEDIUM_HOURS=24
NOTIFICATION_UNRESOLVED_LOW_HOURS=72
NOTIFICATION_DELIVERY_TIMEOUT_SECONDS=10

# Discord incoming webhook. Keep this file mode 0600 and never commit the real URL.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me

LOG_LEVEL=INFO
