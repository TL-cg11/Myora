{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline DeadLetter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "error_code",
    "failure_stage",
    "retryable",
    "detector_version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0",
      "$comment": "입출력 계약 버전"
    },
    "error_code": {
      "type": "string",
      "maxLength": 64,
      "$comment": "원문을 포함하지 않는 고정 오류 코드"
    },
    "failure_stage": {
      "enum": [
        "DECODE",
        "VALIDATE",
        "DETECT_MASK",
        "BUILD_EVENT"
      ],
      "$comment": "실패한 처리 단계"
    },
    "retryable": {
      "type": "boolean",
      "$comment": "원인 해결 후 재시도할 수 있는 오류인지 표시"
    },
    "detector_version": {
      "type": "string",
      "maxLength": 32,
      "$comment": "탐지 프로그램 버전"
    },
    "line_number": {
      "type": "integer",
      "minimum": 1,
      "$comment": "파일 입력의 1부터 시작하는 행 번호. 함수 직접 호출 결과에서는 생략한다."
    }
  },
  "$comment": "B 탐지기 v1 계약. $comment는 개발자를 위한 설명이며 검증 조건이나 전송 필드가 아니다."
}
