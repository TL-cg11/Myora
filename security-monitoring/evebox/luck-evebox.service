[Unit]
Description=LUCK EveBox Suricata web console
After=network-online.target suricata.service
Wants=network-online.target
Requires=suricata.service

[Service]
Type=simple
User=evebox
Group=evebox
ExecStart=/usr/local/bin/evebox server --no-tls --sqlite --host 127.0.0.1 --port 5636 --data-directory /var/lib/evebox /var/log/suricata/eve.json
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/evebox

[Install]
WantedBy=multi-user.target
