[Unit]
Description=LUCK Suricata IDS event classifier
After=suricata.service
Requires=suricata.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/lib/luck-security/ids_classifier.py
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/luck-security /var/lib/luck-security

[Install]
WantedBy=multi-user.target
