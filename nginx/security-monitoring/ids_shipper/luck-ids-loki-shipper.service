[Unit]
Description=LUCK Suricata IDS JSONL to Loki shipper
After=network-online.target loki.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=adm
EnvironmentFile=/etc/luck-ids-loki-shipper.env
ExecStart=/usr/local/lib/luck-security/ids_loki_shipper.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/log/luck-security /var/lib/luck-security

[Install]
WantedBy=multi-user.target
