# MariaDB security_monitoring sink account
SECURITY_DB_HOST=100.104.124.29
SECURITY_DB_PORT=3306
SECURITY_DB_NAME=security_monitoring
SECURITY_DB_USER=security_monitoring_sink
SECURITY_DB_PASSWORD=change-me
# Single-threaded workers reuse one connection; this controls idle health checks.
SECURITY_DB_PING_INTERVAL_SECONDS=1
SECURITY_SINK_BATCH_SIZE=100
SECURITY_SINK_BATCH_WAIT_SECONDS=0.1
MASKED_LOG_SINK_BATCH_SIZE=100
MASKED_LOG_SINK_BATCH_WAIT_SECONDS=0.1

# Kafka connection (TLS/SASL values are optional when the broker is plaintext)
KAFKA_BOOTSTRAP_SERVERS=100.66.77.55:9092
SECURITY_EVENT_CONSUMER_GROUP=security-event-sink
MASKED_LOG_CONSUMER_GROUP=masked-log-sink
KAFKA_AUTO_OFFSET_RESET=earliest
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/ca-certificates.crt

# Loki is bound to localhost by the observability installation.
LOKI_URL=http://127.0.0.1:3100
LOKI_PUSH_TIMEOUT_SECONDS=5
MASKED_LOG_BUFFER_DIR=/var/lib/luck-security-sink/masked-log-buffer
MASKED_LOG_BUFFER_MAX_BYTES=1073741824
MASKED_LOG_BUFFER_REPLAY_SECONDS=60

# Sink와 관측 스택은 Nginx 서버에서 함께 실행한다. metric 포트는 외부에 공개하지 않는다.
METRICS_HOST=100.117.253.9
SECURITY_EVENT_METRICS_PORT=9108
MASKED_LOG_METRICS_PORT=9109

# The event sink transactionally queues application notification channels.
SECURITY_NOTIFICATION_CHANNELS=DISCORD

LOG_LEVEL=INFO
