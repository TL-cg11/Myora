      "targets": [{"editorMode": "code", "expr": "sum by (consumer_group, topic) (rate(luck_sink_messages_total{result=\"processed\"}[$__rate_interval]))", "legendFormat": "{{consumer_group}} / {{topic}}", "range": true, "refId": "A"}],
      "title": "Processing throughput",
