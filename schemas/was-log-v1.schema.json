{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myohan.example/schemas/was-log-v1.schema.json",
  "title": "Myohan WAS Kafka log v1",
  "description": "myohan.was.app topic으로 발행하는 WAS 구조화 로그",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "timestamp", "source", "service", "event_type", "request_id"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "timestamp": {"type": "string", "format": "date-time", "description": "UTC RFC 3339 시각"},
    "source": {"const": "was"},
    "service": {"type": "string", "enum": ["saju", "tarot", "face"], "description": "단일 topic 안에서 기능을 구분"},
    "event_type": {"type": "string", "enum": ["api_request", "ai_request", "ai_response", "error"]},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128, "description": "Nginx부터 AI 호출까지 이어지는 요청 ID"},
    "user_id": {"type": ["integer", "null"], "minimum": 1, "description": "서버에서 인증한 사용자 ID"},
    "guest_key": {"type": ["string", "null"], "format": "uuid", "description": "현재 비회원 요청을 연결하는 브라우저 UUID. PII 마스킹 대상"},
    "method": {"type": ["string", "null"], "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "OPTIONS", "HEAD", null]},
    "uri": {"type": ["string", "null"], "maxLength": 500, "pattern": "^/[^?]*$", "description": "query string을 제외한 API 경로"},
    "status": {"type": ["integer", "null"], "minimum": 100, "maximum": 599},
    "client_ip": {"type": ["string", "null"], "maxLength": 45, "description": "PII 마스킹 대상"},
    "processing_time": {"type": ["number", "null"], "minimum": 0, "description": "초 단위 처리 시간"},
    "input": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "description": "필드별 보안 처리는 was-log-masking-policy-v1.json을 따름",
      "properties": {
        "name": {"type": ["string", "null"], "maxLength": 100},
        "birth_date": {"type": ["string", "null"], "format": "date"},
        "birth_time": {"type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
        "gender": {"type": ["string", "null"], "enum": ["male", "female", "unknown", null]},
        "topic": {"type": ["string", "null"], "maxLength": 50},
        "question": {"type": ["string", "null"], "maxLength": 2000},
        "prompt": {"type": ["string", "null"], "maxLength": 16000}
      }
    },
    "ai": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["provider", "model"],
      "properties": {
        "provider": {"type": "string", "minLength": 1, "maxLength": 50},
        "model": {"type": "string", "minLength": 1, "maxLength": 100},
        "latency": {"type": ["number", "null"], "minimum": 0, "description": "초 단위 AI 응답 시간"}
      }
    },
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["type", "message"],
      "properties": {
        "type": {"type": "string", "minLength": 1, "maxLength": 200},
        "code": {"type": ["string", "null"], "maxLength": 100},
        "message": {"type": "string", "minLength": 1, "maxLength": 1000, "description": "비밀값을 제거한 오류 메시지"}
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "content_length": {"type": ["integer", "null"], "minimum": 0},
        "response_length": {"type": ["integer", "null"], "minimum": 0},
        "reading_id": {"type": ["integer", "null"], "minimum": 1},
        "retry_count": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"event_type": {"const": "api_request"}}, "required": ["event_type"]},
      "then": {"required": ["method", "uri", "status", "client_ip", "processing_time"]}
    },
    {
      "if": {"properties": {"event_type": {"enum": ["ai_request", "ai_response"]}}, "required": ["event_type"]},
      "then": {"required": ["ai"]}
    },
    {
      "if": {"properties": {"event_type": {"const": "error"}}, "required": ["event_type"]},
      "then": {"required": ["error"]}
    }
  ]
}
