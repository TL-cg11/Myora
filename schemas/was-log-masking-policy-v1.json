{
  "policy_version": "1.0",
  "schema_version": "1.0",
  "description": "WAS 로그 필드 경로별 마스킹 및 탐지 정책",
  "scope": "명시된 필드와 input 객체의 새 필드",
  "fields": {
    "user_id": {
      "pii": true,
      "action": "pseudonymize",
      "detectors": []
    },
    "guest_key": {
      "pii": true,
      "action": "pseudonymize",
      "detectors": []
    },
    "client_ip": {
      "pii": true,
      "action": "mask_ip",
      "detectors": []
    },
    "input.name": {
      "pii": true,
      "action": "mask_name",
      "detectors": []
    },
    "input.birth_date": {
      "pii": true,
      "action": "mask_date",
      "detectors": []
    },
    "input.birth_time": {
      "pii": true,
      "action": "mask_time",
      "detectors": []
    },
    "input.question": {
      "pii": true,
      "action": "detect_and_mask",
      "detectors": ["email", "phone", "person_name", "birth_date", "address", "credential"],
      "prompt_injection_detection": true
    },
    "input.prompt": {
      "pii": true,
      "action": "detect_and_mask",
      "detectors": ["email", "phone", "person_name", "birth_date", "address", "credential"],
      "prompt_injection_detection": true
    },
    "input.topic": {
      "pii": false,
      "action": "pass",
      "detectors": []
    },
    "input.gender": {
      "pii": false,
      "action": "pass",
      "detectors": []
    }
  },
  "default": {
    "unknown_input_field_action": "reject",
    "other_schema_field_action": "pass"
  }
}
