# MariaDB security_monitoring sink account
SECURITY_DB_HOST=100.104.124.29
SECURITY_DB_PORT=3306
SECURITY_DB_NAME=security_monitoring
SECURITY_DB_USER=security_monitoring_sink
SECURITY_DB_PASSWORD=change-me

# Kafka connection (TLS/SASL values are optional when the broker is plaintext)
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
SECURITY_EVENT_CONSUMER_GROUP=security-event-sink
MASKED_LOG_CONSUMER_GROUP=masked-log-sink
KAFKA_AUTO_OFFSET_RESET=earliest
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=PLAIN
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_SSL_CA_LOCATION=/etc/ssl/certs/ca-certificates.crt

# Loki is bound to localhost by the observability installation.
LOKI_URL=http://127.0.0.1:3100
LOKI_PUSH_TIMEOUT_SECONDS=5
MASKED_LOG_BUFFER_DIR=/var/lib/luck-security-sink/masked-log-buffer
MASKED_LOG_BUFFER_MAX_BYTES=1073741824
MASKED_LOG_BUFFER_REPLAY_SECONDS=60

LOG_LEVEL=INFO
