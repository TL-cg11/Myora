{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luck.local/contracts/luck.masked-logs.v1.schema.json",
  "title": "luck.masked-logs v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "schema_version",
    "occurred_at",
    "environment",
    "source_service",
    "source_type",
    "masking_policy_version",
    "masked_message"
  ],
  "properties": {
    "event_id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "schema_version": { "const": "1.0" },
    "request_id": { "type": ["string", "null"], "maxLength": 64 },
    "occurred_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "environment": {
      "type": "string",
      "enum": ["development", "test", "staging", "production"]
    },
    "source_service": { "type": "string", "minLength": 1, "maxLength": 64 },
    "source_type": { "type": "string", "minLength": 1, "maxLength": 64 },
    "masking_policy_version": { "type": "string", "minLength": 1, "maxLength": 32 },
    "masked_message": { "type": "string", "maxLength": 65535 },
    "body_hash": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "safe_metadata": { "type": ["object", "null"] }
  }
}
