APP_NAME=luck-was
APP_ENV=development
HOST=0.0.0.0
PORT=8000
DB_HOST=100.104.124.29
DB_PORT=3306
DB_NAME=luck_db
DB_USER=luck_user
DB_PASSWORD=change-me
SECURITY_DB_HOST=100.104.124.29
SECURITY_DB_PORT=3306
SECURITY_DB_NAME=security_monitoring
SECURITY_DB_USER=security_monitoring_api
SECURITY_DB_PASSWORD=change-me
# JSON: SHA-256(token) -> security_user.actor_id
SECURITY_AUTH_TOKEN_HASHES={}
# 사주·타로·관상 생성과 가드레일 검사의 공통 AI 설정
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_REQUEST_TIMEOUT=20
AI_CONNECT_TIMEOUT=5
AI_TOTAL_TIMEOUT=25
AI_MAX_TOKENS=700
AI_CHECK_MAX_TOKENS=250
AI_HISTORY_LIMIT=10
AI_MESSAGE_MAX_CHARS=1500
AI_CONTEXT_MAX_CHARS=8000
AI_ANSWER_MAX_CHARS=4000
CHAT_QUESTION_LIMIT=5

# 기존 서비스별 키·모델은 공통값과 다를 때만 재정의한다.
# DEEPSEEK_SAJU_API_KEY=
# DEEPSEEK_TAROT_API_KEY=
# DEEPSEEK_FACE_API_KEY=
# DEEPSEEK_SAJU_MODEL=
# DEEPSEEK_TAROT_MODEL=
# DEEPSEEK_FACE_MODEL=
# AI_GUARDRAIL_MODEL=deepseek-v4-flash

# Kafka 보안 로그 Consumer
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Kafka 마스킹 어댑터 (security-monitoring/detector, python -m adapter)
# 가명화 키는 UTF-8 32바이트 이상. 없으면 어댑터가 시작하지 않는다.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
MASKING_PSEUDONYM_KEY=
# 탐지 증거 지문 키(선택). 없으면 evidence_fingerprint를 남기지 않는다.
DETECTOR_FINGERPRINT_KEY=
# 자유 텍스트 이름·장소 NER. requirements-ner.txt 설치 후 활성화한다.
DETECTOR_NER_ENABLED=false
DETECTOR_NER_MODEL=Leo97/KoELECTRA-small-v3-modu-ner
DETECTOR_NER_THRESHOLD=0.85
# true이면 서버에 미리 내려받은 모델만 사용하고 네트워크 다운로드를 막는다.
DETECTOR_NER_LOCAL_FILES_ONLY=false
ADAPTER_GROUP_ID=myohan-security-masking
ADAPTER_INPUT_TOPICS=myohan.was.app,myohan.nginx.access
ADAPTER_MASKED_LOGS_TOPIC=myohan.masked-logs
ADAPTER_SECURITY_EVENTS_TOPIC=myohan.security-events
ADAPTER_DEAD_LETTER_TOPIC=myohan.dead-letter
# 원본 로그에 environment가 없을 때 사용할 값
ADAPTER_DEFAULT_ENVIRONMENT=production
AUTH_SESSION_HOURS=1
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=60
