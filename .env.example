# Myora 로컬 Docker 환경 설정. 복사해서 .env 로 만든다:  cp .env.example .env
# 아래 값은 전부 "내 PC 안에서만" 쓰는 개발용 기본값이다. 외부에 공개되는 서버에 올릴 때는
# 비밀번호·키를 전부 새로 만든다. .env 는 git 에 올라가지 않는다.

# ---------- 포트 (호스트에서 접속하는 주소) ----------
# 사이트: http://localhost:${NGINX_PORT}   Grafana: http://localhost:${GRAFANA_PORT}
NGINX_PORT=80
GRAFANA_PORT=3000
# 아래 세 개는 127.0.0.1 에만 열린다 (디버깅·npm run dev 프록시용)
WAS_PORT=8000
KAFKA_HOST_PORT=9092
MARIADB_PORT=3306

# ---------- MariaDB ----------
MARIADB_ROOT_PASSWORD=myora-root-dev
LUCK_DB_NAME=luck_db
LUCK_DB_USER=luck_user
LUCK_DB_PASSWORD=Luck1234!

# security_monitoring DB 서비스 계정 (mariadb/scripts/apply-security-monitoring-migration.sh 와 동일 구성)
SECURITY_MONITORING_MIGRATION_PASSWORD=sec-migration-dev
SECURITY_MONITORING_SINK_PASSWORD=sec-sink-dev
SECURITY_MONITORING_API_PASSWORD=sec-api-dev
SECURITY_MONITORING_READONLY_PASSWORD=sec-readonly-dev
SECURITY_MONITORING_NOTIFIER_PASSWORD=sec-notifier-dev
SECURITY_MONITORING_RETENTION_PASSWORD=sec-retention-dev
GRAFANA_SECURITY_DB_USER=security_grafana
GRAFANA_SECURITY_DB_PASSWORD=sec-grafana-dev

# ---------- 관제 API (/api/security/*) ----------
# 로컬 테스트용 Bearer 토큰은 `myora-local-security-token` 이고, 아래는 그 SHA-256 이다.
# DB 초기화 때 SECURITY_LOCAL_ACTOR_ID 사용자에게 VIEWER/EDITOR/ADMIN 역할을 준다.
# 새 토큰:  TOKEN=$(openssl rand -hex 32); printf '%s' "$TOKEN" | sha256sum
SECURITY_LOCAL_ACTOR_ID=local-admin
SECURITY_AUTH_TOKEN_HASHES={"955bdebf856b11aa520bf2937e70affdcf9da2202dc7a4afa03ec9ae4da35eb3":"local-admin"}

# ---------- AI (DeepSeek) ----------
# 비워 두면 채팅은 검수된 고정 안내(rule)만 반환하고 사주·타로·관상 결과 자체는 정상 동작한다.
# 공통 키 하나를 쓰거나, 운영 서버처럼 서비스별 키 3개를 따로 넣는다(있으면 서비스별 키가 우선).
DEEPSEEK_API_KEY=
DEEPSEEK_SAJU_API_KEY=
DEEPSEEK_TAROT_API_KEY=
DEEPSEEK_FACE_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_REQUEST_TIMEOUT=20
AI_CONNECT_TIMEOUT=5
AI_CHECK_TIMEOUT=10
AI_TOTAL_TIMEOUT=45
AI_MAX_TOKENS=700
AI_CHECK_MAX_TOKENS=250
AI_HISTORY_LIMIT=10
AI_MESSAGE_MAX_CHARS=1500
AI_CONTEXT_MAX_CHARS=8000
AI_ANSWER_MAX_CHARS=4000
CHAT_QUESTION_LIMIT=5
CHAT_QUESTION_LIMIT_ADMIN=20

# ---------- 회원 인증 정책 ----------
AUTH_SESSION_HOURS=1
# 로그인 실패 잠금은 클라이언트 IP 단위 (5회 실패 → 60분)
AUTH_IP_MAX_FAILED_ATTEMPTS=5
AUTH_IP_LOCKOUT_MINUTES=60
SESSION_COOKIE_SAMESITE=lax

# ---------- 로그 마스킹 어댑터 (was/security-monitoring/detector) ----------
# 가명화 키는 UTF-8 32바이트 이상. 바꾸면 이전 가명 토큰과의 연결이 끊긴다.
# 새 키:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MASKING_PSEUDONYM_KEY=myora-local-dev-pseudonym-key-change-me-0123456789
DETECTOR_FINGERPRINT_KEY=
# 한국어 NER(KoELECTRA) / 문맥 재검증(KLUE NLI) 모델. 운영 서버는 둘 다 켜져 있다.
# 켜려면 ADAPTER_BUILD_TARGET=adapter-ner 로 바꾸고 `docker compose up -d --build was`.
# 모델(약 900MB)은 첫 실행 때 Hugging Face 에서 내려받거나, 서버 캐시를 hf-cache 볼륨에 복사한다
# (scripts/import-hf-cache.sh). 기본은 정규식만 쓰는 가벼운 이미지다.
ADAPTER_BUILD_TARGET=runtime
DETECTOR_NER_ENABLED=false
DETECTOR_NER_MODEL=Leo97/KoELECTRA-small-v3-modu-ner
DETECTOR_NER_THRESHOLD=0.85
DETECTOR_NER_LOCAL_FILES_ONLY=false
DETECTOR_PII_CONTEXT_ENABLED=false
DETECTOR_PII_CONTEXT_MODEL=Huffon/klue-roberta-base-nli
DETECTOR_PII_CONTEXT_NON_PII_THRESHOLD=0.70
DETECTOR_PII_CONTEXT_LOCAL_FILES_ONLY=false
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
ADAPTER_DEFAULT_ENVIRONMENT=development

# ---------- Grafana ----------
# Grafana 는 http://localhost/grafana/ (nginx 뒤) 로만 접근하며, 사이트에 관리자(role=admin) 계정으로
# 로그인한 사용자가 자동으로 Grafana 사용자가 된다. 아래 admin 계정은 provisioning/API 용이다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=myora-grafana-dev
GRAFANA_DOMAIN=localhost
GRAFANA_ROOT_URL=http://localhost/grafana/
GRAFANA_AUTO_ASSIGN_ORG_ROLE=Viewer

# ---------- Discord 알림 (선택, `--profile notify`) ----------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/replace-me
NOTIFICATION_GROUP_WINDOW_SECONDS=0
NOTIFICATION_POLL_SECONDS=1
# 알림에 붙는 이벤트 상세 링크 (팀원이 여는 주소 기준으로 바꾼다)
GRAFANA_SECURITY_EVENTS_URL=http://localhost/grafana/d/luck-security-events

# ---------- sink 성능 ----------
SECURITY_DB_PING_INTERVAL_SECONDS=1
SECURITY_SINK_BATCH_SIZE=100
SECURITY_SINK_BATCH_WAIT_SECONDS=0.1
MASKED_LOG_SINK_BATCH_SIZE=100
MASKED_LOG_SINK_BATCH_WAIT_SECONDS=0.1

LOG_LEVEL=INFO
